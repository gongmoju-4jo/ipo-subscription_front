# 정적 파일(React 빌드)을 서빙하고 /api 는 게이트웨이로 넘긴다.
# 브라우저는 이 nginx 하나만 보므로 같은 출처다 → 게이트웨이에 CORS 설정이 필요 없다.
# ${GATEWAY_URL} 은 컨테이너 시작 때 환경변수로 채워진다 (nginx 이미지의 templates 기능).

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 게이트웨이로 가는 모든 API. 경로는 그대로 넘긴다 (/api/v1/... → ${GATEWAY_URL}/api/v1/...)
    location /api/ {
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Authorization 은 그대로 전달된다. X-User-Id 등은 게이트웨이가 지우고 다시 설정하므로 여기서 만들지 않는다
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # 해시가 붙은 정적 파일은 오래 캐시
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html 은 캐시하지 않는다 (배포하면 바로 새 해시 파일을 가리키게)
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # 새로고침해도 /ipos/xxx 같은 경로가 열리게 SPA 로 돌린다
    location / {
        try_files $uri /index.html;
    }
}
